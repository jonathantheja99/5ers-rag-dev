# Google Gemini API key (required). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Optional overrides (defaults shown) ---

# Compiled single source of truth used for retrieval.
# KNOWLEDGE_BASE_PATH=../knowledge_base/faq_data.md

# Directory holding the source knowledge files (used by compiler.py).
# KNOWLEDGE_BASE_DIR=../knowledge_base

# Persisted Chroma vector store.
# CHROMA_DB_PATH=./chroma_db

# Models and retrieval tuning.
# CHAT_MODEL=gemini-3.5-flash-lite
# Note: free-tier quotas are per-model and per-day. Each question costs TWO
# generate requests (relevance gate + answer), so pick a model with headroom.
# EMBEDDING_MODEL=models/gemini-embedding-001
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# RETRIEVAL_K=6

# Comma-separated CORS origins allowed to call /chat.
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where scraper.py drops raw crawls (never faq_data.md).
# SCRAPER_OUTPUT_DIR=../knowledge_base/scraped

# PORT=8000
